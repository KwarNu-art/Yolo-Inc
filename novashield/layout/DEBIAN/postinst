#!/bin/sh
set -e

# NovaShield Post-Installation Script for Sileo & Zebra
# Triggers SpringBoard reload immediately so user sees the reaction on screen

if [ "$1" = "configure" ]; then
    if [ -f /var/jb/usr/bin/sbreload ]; then
        /var/jb/usr/bin/sbreload 2>/dev/null || true
    elif [ -f /var/jb/usr/bin/killall ]; then
        /var/jb/usr/bin/killall -9 SpringBoard 2>/dev/null || true
    else
        killall -9 SpringBoard 2>/dev/null || true
    fi
fi

exit 0
